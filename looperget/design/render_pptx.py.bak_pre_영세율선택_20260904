                        skip_pred=(lambda sh: sh.shape_type != 6) if mf.get("groups_only") else None)
            for old, new in mf.get("replace", []):
                replace_text(ns, old, new)
            for lb in mf.get("labels", []):
                x, y, txt = lb[0], lb[1], lb[2]
