                         "WF 4-1 %d · WF 4-2 %d · 밴드 %d" % (S["n_joints"], S["n_joints"], 4 * S["n_joints"])])
        rows.append(["c  말단 마감", S["sets"]["end50"], str(S["n_ends"]), "E호스밸브 1 + 호스밴드 2",
                     "E호스밸브 %d · 밴드 %d" % (S["n_ends"], 2 * S["n_ends"])])
